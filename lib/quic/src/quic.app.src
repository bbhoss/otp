{application, quic,
   [{description, "Erlang/OTP QUIC Transport (RFC 9000)"},
    {vsn, "%VSN%"},
    {modules, [gen_quic,
               quic,
               quic_app,
               quic_sup,
               quic_listener_sup,
               quic_connection_sup,
               quic_listener,
               quic_connection,
               quic_stream,
               quic_packet,
               quic_frame,
               quic_varint,
               quic_crypto,
               quic_tls,
               quic_transport_params,
               quic_recovery]},
    {registered, [quic_sup, quic_listener_sup, quic_connection_sup]},
    {applications, [crypto, public_key, kernel, stdlib]},
    {env, []},
    {mod, {quic_app, []}}]}.
